      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 4,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "ffkmga95nrldsa"
          },
          "query": "from(bucket: \"Proxmox\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"cpustat\" and r.host == \"${node}\" and r._field == \"cpu\")\n  |> last()\n  |> map(fn: (r) => ({_time: r._time, _value: r._value * 100.0}))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
