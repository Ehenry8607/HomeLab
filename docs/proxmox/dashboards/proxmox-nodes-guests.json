    {
      "id": 8,
      "type": "table",
      "title": "$node: VMs and containers (now)",
      "datasource": {
        "type": "influxdb",
        "uid": "ffkmga95nrldsa"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "ffkmga95nrldsa"
          },
          "query": "from(bucket: \"Proxmox\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"system\" and r.nodename == \"${node}\" and exists r.vmid)\n  |> filter(fn: (r) => r._field == \"cpu\" or r._field == \"cpus\" or r._field == \"mem\" or r._field == \"maxmem\" or r._field == \"uptime\")\n  |> last()\n  |> map(fn: (r) => ({r with _value: float(v: r._value)}))\n  |> group(columns: [\"host\", \"vmid\", \"object\"])\n  |> drop(columns: [\"_time\", \"_start\", \"_stop\", \"_measurement\", \"nodename\"])\n  |> pivot(rowKey: [\"host\", \"vmid\", \"object\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group()\n  |> map(fn: (r) => ({\"Name\": r.host, \"ID\": r.vmid, \"Type\": if r.object == \"lxc\" then \"LXC\" else \"VM\", \"Status\": if r.uptime > 0.0 then \"running\" else \"stopped\", \"CPU %\": r.cpu * 100.0, \"Cores\": r.cpus, \"RAM used\": r.mem, \"RAM limit\": r.maxmem, \"RAM %\": if r.maxmem > 0.0 then r.mem / r.maxmem * 100.0 else 0.0}))\n  |> sort(columns: [\"CPU %\"], desc: true)"
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "CPU %",
            "desc": true
          }
        ],
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "CPU %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
